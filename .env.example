# Neon Postgres — get from https://neon.tech → Dashboard → Connection Details
# Pooled (PgBouncer) — for app traffic
DATABASE_URL=postgresql://neondb_owner:***@ep-pooler.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct — for schema migrations (Prisma db push/migrate)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:***@ep.neon.tech/neondb?sslmode=require&channel_binding=require

# OpenRouter — free for estimation + paid quality for image
# Estimation: minimax/minimax-m3:free (vision+JSON, Arabic, free — good for this app)
# Image: google/gemini-2.5-flash-image $0.035/image (quality text+image->image)
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=minimax/minimax-m3:free
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
