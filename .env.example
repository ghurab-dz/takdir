# Neon Postgres — get from https://neon.tech → Dashboard → Connection Details
# Pooled (PgBouncer) — for app traffic
DATABASE_URL=postgresql://neondb_owner:password@ep-pooler.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct — for schema migrations (Prisma db push/migrate)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep.neon.tech/neondb?sslmode=require&channel_binding=require

# Google Gemini — free from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
# Optional — defaults to gemini-3.6-flash in src/lib/ai/gemini.ts
# GEMINI_MODEL=gemini-3.6-flash
# Optional — image model for quote-locked proof renders (free tier)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
